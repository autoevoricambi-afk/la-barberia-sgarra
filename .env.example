# Backend booking — non inserire mai valori reali nel repository.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Uno o più indirizzi autorizzati, separati da virgola.
ADMIN_EMAILS=paolo@example.com
ADMIN_REDIRECT_URL=https://la-barberia-sgarra.vercel.app/admin/

# Protezione richieste e cron (almeno 32 caratteri casuali).
RATE_LIMIT_SALT=replace-with-random-secret
CRON_SECRET=replace-with-random-secret

# Notifiche: configurare Resend oppure un webhook.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=La Barberia Sgarra <prenotazioni@example.com>
BARBER_NOTIFICATION_EMAIL=paolo@example.com
BOOKING_NOTIFICATION_WEBHOOK_URL=
BOOKING_NOTIFICATION_WEBHOOK_SECRET=

# Backup locale cifrato: chiave esadecimale da 64 caratteri.
BACKUP_ENCRYPTION_KEY=
